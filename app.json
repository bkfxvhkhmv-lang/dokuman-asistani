{
  "expo": {
    "name": "BriefPilot",
    "slug": "briefpilot",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4361EE"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        { "defaultChannel": "briefpilot_default", "color": "#2563eb" }
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-mail-composer",
      "expo-localization",
      "./plugins/withShareExtension",
      "./plugins/withWidget"
    ],
    "scheme": "briefpilot",
    "ios": {
      "bundleIdentifier": "com.briefpilot.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Erlaube die Kamera, um Briefe direkt zu scannen.",
        "NSPhotoLibraryUsageDescription": "Wähle vorhandene Fotos oder Dokumente aus deiner Galerie."
      }
    },
    "android": {
      "package": "com.briefpilot.app"
    },
    "extra": {
      "APP_ENV": "device",
      "googleAndroidClientId": "",
      "googleWebClientId": "",
      "googleIosClientId": ""
    }
  }
}
