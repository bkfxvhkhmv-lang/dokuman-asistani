# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bp:bp_secret@localhost:5432/briefpilot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=briefpilot-docs
MINIO_SECURE=false

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Supabase — project root (https://xxx.supabase.co). Used to fetch JWKS for Current ECC/RS256 tokens.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional override; default is {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#SUPABASE_JWKS_URL=

# Legacy / Previous JWT only — HS256 symmetric secret (JWT Settings → Legacy JWT secret).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_VERIFY_AUDIENCE=true
# Optional strict iss (requires SUPABASE_URL): https://ref.supabase.co/auth/v1
#SUPABASE_VERIFY_ISSUER=false
#SUPABASE_JWT_ISSUER=

SHARE_PUBLIC_BASE_URL=https://share.briefpilot.de

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | local
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Shadow-mode: log parser vs current LLM extraction in decision_worker (observe only).
# EXTRACTION_SHADOW_MODE=false

# ── OCR ───────────────────────────────────────────────────────────────────────
# PaddleOCR 3.x: motor Paddle ile (torch bu backend’de kullanılmıyor). Pip’te
# `paddleocr[all]` veya doc-pipeline ekstraları transformers vb. çeker — çakışma riski; saf OCR için `paddleocr` yeterli.
#
# Dev smoke / Pixel OCR working config (#146-C3, 2026-06-17):
#   PROCESS_OCR_INLINE_DEV=false  → upload 201+pending; worker-ocr runs OCR (not inline in API)
#   OCR_PIPELINE_VERSION=PP-OCRv4
#   OCR_LANG=en                   → required for PP-OCRv4 (de/latin fail on v4)
#   OCR_MAX_IMAGE_SIDE=2048
#   After .env changes: docker compose up -d --force-recreate api worker-ocr (restart alone does not reload env)
#
# Language / pipeline matrix (local smoke):
#   PP-OCRv4 + en     → OK (German PDFs may still detect language=de in result)
#   PP-OCRv4 + de     → FAIL — not supported
#   PP-OCRv4 + latin  → FAIL — not supported
#   PP-OCRv5 + en     → OK
#   PP-OCRv5 + de     → OK but large scanned PDFs → worker SIGKILL/OOM
#   PP-OCRv5 + latin  → FAIL
#
# Local backend/.env is gitignored — copy values from here; runtime tweaks are not committed.
#
# OCR_ENABLED=true          # false → upload stores file only; no Paddle/Celery OCR
OCR_LANG=en                  # PP-OCRv4: must be en. de only with PP-OCRv5 (OOM risk on large PDFs)
OCR_USE_GPU=false
OCR_MAX_IMAGE_SIDE=2048      # düşük RAM: büyük görüntüyü Paddle öncesi küçült; 0=kapalı
OCR_PIPELINE_VERSION=PP-OCRv4   # lighter pipeline; PP-OCRv5+de on large scans → SIGKILL/OOM
# OCR_SUBPROCESS_TIMEOUT_SEC=600  # inline Paddle child process wall clock
# false recommended for dev smoke / Pixel — uses worker-ocr instead of inline API subprocess
PROCESS_OCR_INLINE_DEV=false

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
