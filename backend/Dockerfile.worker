FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 libgl1 libglib2.0-0 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

ARG PADDLE_CPU_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cpu/
RUN pip install --no-cache-dir \
    -i "${PADDLE_CPU_INDEX}" --trusted-host www.paddlepaddle.org.cn \
    "paddlepaddle>=3.0.0,<4.0.0"

COPY pyproject.toml .
RUN pip install --no-cache-dir -e "."

RUN python -c "\
from paddleocr import PaddleOCR\n\
kw = dict(lang='de', use_doc_orientation_classify=False, use_doc_unwarping=False, use_textline_orientation=False)\n\
try:\n\
    PaddleOCR(**kw)\n\
except TypeError:\n\
    PaddleOCR(lang='de')"

COPY app/ ./app/
